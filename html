<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Web Development</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header -->
    <header class="bg-primary text-white p-3">
        <div class="container">
            <h1>Modern Web Development</h1>

            <nav>
                <a href="#" class="text-white me-3">Home</a>
                <a href="#" class="text-white me-3">About</a>
                <a href="#" class="text-white">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container my-5">

        <section class="text-center mb-5">
            <h2>Responsive Front-End Design</h2>

            <p>
                Modern web development focuses on creating
                responsive and user-friendly websites using
                HTML, CSS, JavaScript, and frameworks like Bootstrap.
            </p>
        </section>

        <!-- Cards -->
        <section class="row">

            <div class="col-md-4 mb-4">
                <div class="card shadow p-3 h-100">
                    <h3>HTML</h3>
                    <p>Provides the structure of web pages.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card shadow p-3 h-100">
                    <h3>CSS</h3>
                    <p>Used for styling and responsive layouts.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card shadow p-3 h-100">
                    <h3>Bootstrap</h3>
                    <p>Helps developers build responsive websites faster.</p>
                </div>
            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center p-3">
        <p>&copy; 2026 Modern Web Development Project</p>
    </footer>

</body>
</html>
